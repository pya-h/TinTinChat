+        $letters = function_exists('mb_substr')
+            ? mb_substr($trimmed, 0, 1, 'UTF-8')
+            : substr($trimmed, 0, 1);
+    }
+
+    return function_exists('mb_strtoupper')
+        ? mb_strtoupper($letters, 'UTF-8')
