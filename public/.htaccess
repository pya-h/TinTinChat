# Public document root for TinTinChat (cPanel: map this folder's CONTENTS to
# public_html, and keep ../tintin-core OUTSIDE the web root).

# Disable directory browsing so no folder (assets, api, etc.) can be listed.
Options -Indexes

# Block access to hidden/sensitive files if any ever land here.
<FilesMatch "^\.(env|git|htaccess)|\.(env|ini|log|fux|sql|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
